{
  "version": "5.0.0-full-clinical-frozen-beats",
  "seed": 42,
  "outer_folds": 10,
  "inner_folds": 5,
  "outer_train_calibration_fraction": 0.2,
  "target_sensitivity": 0.9,
  "selection_rule": "mean_inner_UAR_then_AUC_then_candidate_id",
  "cpu_threads": 8,
  "require_cuda_for_full": true,
  "vram_limit_gb": 45.0,
  "vram_headroom_gb": 3.0,
  "beats_batch_size": 64,
  "beats_max_batch_size": 256,
  "beats_precision": "float32",
  "beats_checkpoint": "pretrained/v5/BEATs_iter3_plus_AS2M.pt",
  "tabpfn_checkpoint": "pretrained/v5/tabpfn-v2-classifier-v2_default.ckpt",
  "tabpfn_device": "cuda",
  "tabpfn_estimators": 4,
  "tabpfn_fit_mode": "fit_with_cache",
  "tabpfn_prediction_chunk": 128,
  "pca_components": [32, 64],
  "lr_C": [0.001, 0.01, 0.1],
  "catboost_trials": [
    {"depth": 3, "iterations": 600, "learning_rate": 0.03, "l2_leaf_reg": 10},
    {"depth": 4, "iterations": 800, "learning_rate": 0.03, "l2_leaf_reg": 20},
    {"depth": 5, "iterations": 800, "learning_rate": 0.03, "l2_leaf_reg": 30}
  ],
  "bootstrap_repeats": 1000,
  "xai_per_outer_fold": 4,
  "xai_background": 8,
  "individual_xai_permutations": 16,
  "hr_shifts_bpm": [-10, -5, 5, 10],
  "gate_calibration_target": 0.99,
  "feature_workers": 4,
  "notes": "44 fixed candidates including 4 cached blends and 6 matched-pooling controls; 12 fitted outputs plus selected_full; all select inner UAR. Same V4 local participant splits (20% calibration), not exact author code protocol (15%, StratifiedGroupKFold). No fine-tuning; no guaranteed improvement or camera validation. GB decimal: 1e9 bytes. One GPU-heavy job at a time."
}
